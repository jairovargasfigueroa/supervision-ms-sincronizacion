PORT=8084
# development (por defecto) o production: en production los registros salen en JSON (601)
NODE_ENV=development
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=supervision
AUDIENCIA=plataforma-api
# Obligatorias (601: sin valor por defecto en el código); en la nube, sus direcciones públicas con https://
OBRAS_URL=http://localhost:8081
MATERIALES_URL=http://localhost:8082
# DynamoDB Local del Docker Compose de infra (en AWS se deja vacío y se usan las credenciales del entorno)
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=sa-east-1
# Valores de prueba: DynamoDB Local acepta cualquier clave
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Solo en desarrollo: crea las tablas al iniciar si no existen
DYNAMODB_CREAR_TABLAS=true
# Opcionales: nombres de las tablas (las pruebas usan los suyos)
# TABLA_OPERACION_PROCESADA=operacion_procesada
# TABLA_ESTADO_DISPOSITIVO=estado_dispositivo
TIEMPO_MAXIMO_LLAMADA_MS=5000
TIEMPO_MAXIMO_LOTE_MS=20000
# Opcional (ensayo local de la 601): ruta de una CA adicional para llamar a Obras y Materiales por HTTPS
# NODE_EXTRA_CA_CERTS=/certificados/ca.crt
